          event.clientX - rect.left;

        const mouseY =
          event.clientY - rect.top;


        const centerX =
          rect.width / 2;

        const centerY =
          rect.height / 2;


        const rotateY =
          ((mouseX - centerX) / centerX) * 4;


        const rotateX =
          -((mouseY - centerY) / centerY) * 3;


        boxObject.style.transform =
          `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;

