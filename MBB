function unlockMysteryCase() {

  if (
    !groupSelect ||
    !caseCode
  ) {
    return;
  }


  const group =
    groupSelect.value;


  const code =
    caseCode.value
      .trim()
      .toUpperCase();


  const mystery =
    mysteryCases[code];


  if (!mystery) {

    if (codeError) {

      codeError.textContent =
        "Kode belum sesuai. Coba periksa kembali.";

    }

