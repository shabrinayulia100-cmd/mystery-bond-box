  if (!content) return;


  /* HANYA TAMPILKAN GAMBAR KASUS */

  content.innerHTML = `
    <img
      src="${mystery.image}"
      alt="${mystery.title}"
    >
  `;


  slot.classList.add("unlocked");


  caseCode.value = "";

}


