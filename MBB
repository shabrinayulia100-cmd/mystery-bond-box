    width: 220px;
    height: 52px;
  }

  .box-glow-image {
    width: 310px;

    bottom: 135px;
  }

  .flying-block {
    width: 60px;

    bottom: 200px;
  }

  .box-object.opened .box-lid-image {
    transform:
      translateX(-50%)
      translateY(-95px)
      rotateX(-58deg)
      rotateZ(-2deg);
  }

}


@media (max-width: 480px) {

  .mystery-scene {
    height: 355px;
  }

  .box-object {
    width: 300px;
    height: 315px;
  }

  .box-body-image {
    width: 245px;

    bottom: 8px;
  }

  .box-lid-image {
    width: 255px;

    bottom: 129px;
  }

  .box-inside {
    bottom: 169px;

    width: 182px;
    height: 44px;
  }

  .box-glow-image {
    width: 260px;

    bottom: 110px;
  }

  .flying-block {
    width: 50px;

    bottom: 168px;
  }

  .box-object.opened .box-lid-image {
    transform:
      translateX(-50%)
      translateY(-78px)
      rotateX(-56deg)
      rotateZ(-2deg);
  }

}

/* =========================================================
   28. BLOCK GRID
========================================================= */

.block-grid {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 18px;
}

.block-item {
  position: relative;
  overflow: hidden;

  padding: 16px;

  border: 1px solid var(--border);

  border-radius: 22px;

  background:
    linear-gradient(
      145deg,
      #fffdf9,
      #f6ece4
    );

  box-shadow: var(--shadow-sm);

  color: var(--brown-800);

  transition: 0.2s ease;
}

.block-item:hover {
  transform: translateY(-5px);

  box-shadow: var(--shadow-md);
}

.block-item::after {
  content: "OPEN";

  position: absolute;

  top: 10px;
  right: 10px;

  padding: 5px 8px;

  border-radius: 999px;

  background:
    rgba(90, 64, 51, 0.08);

  color: var(--brown-600);

  font-size: 8px;
  font-weight: 900;
}

.block-item img {
  width: 100%;
  height: 180px;

  object-fit: contain;
}

.block-item span {
  display: block;

  margin-top: 10px;

  font-size: 16px;
  font-weight: 800;
}


/* =========================================================
   29. SILENT BUILD
========================================================= */

.silent-layout {
  display: grid;

  grid-template-columns:
    0.85fr 1.15fr;

  gap: 24px;

  align-items: stretch;

  margin-top: 24px;
}

.silent-timer-card,
.real-block-preview {
  padding: 24px;

  border-radius: 24px;

  background: var(--bg-card);

  border: 1px solid var(--border);

  box-shadow: var(--shadow-sm);
}

.silent-timer-card {
  text-align: center;
}

.timer-caption {
  color: var(--brown-500);

  font-size: 9px;
  font-weight: 900;

  letter-spacing: 0.13em;
}

.silent-timer {
  margin: 10px 0 16px;

  color: var(--brown-800);

  font-size:
    clamp(
      64px,
      8vw,
      100px
    );

  font-weight: 900;

  letter-spacing: -0.04em;
}

.timer-actions {
  display: flex;

  justify-content: center;

  gap: 10px;
}

#silentMessage {
  min-height: 28px;

  margin-top: 12px;

  color: var(--brown-500);

  font-weight: 800;
}

.real-block-preview {
  display: flex;

  flex-direction: column;

  justify-content: center;

  align-items: center;
}

.real-block-preview > span {
  margin-bottom: 12px;

  color: var(--text-soft);

  font-size: 12px;
  font-weight: 700;
}

.real-block-preview img {
  width:
    min(400px, 100%);

  max-height: 300px;

  object-fit: contain;

  filter:
    drop-shadow(
      0 16px 20px
      rgba(48, 38, 33, 0.18)
    );
}

.silent-allowed {
  display: flex;

  flex-wrap: wrap;

  justify-content: center;

  gap: 9px;

  margin-top: 20px;
}

.silent-allowed span {
  padding: 9px 13px;

  border-radius: 999px;

  background: var(--bg-soft);

  color: var(--brown-600);

  font-size: 11px;
  font-weight: 700;
}


/* =========================================================
   30. TOP BLOCK
========================================================= */

.top-block-visual {
  position: relative;

  max-width: 600px;

  margin: 20px auto 0;

  padding: 24px;

  text-align: center;

  border-radius: 24px;

  background:
    linear-gradient(
      145deg,
      #fffdf9,
      #efe2d7
    );

  box-shadow: var(--shadow-sm);
}

.top-block-visual img {
  width:
    min(440px, 100%);

  margin: 0 auto;

  object-fit: contain;
}

.top-block-marker {
  position: absolute;

  top: 18px;
  left: 50%;

  transform:
    translateX(-50%);

  padding: 8px 14px;

  border-radius: 999px;

  background: var(--brown-700);

  color: white;

  font-size: 10px;
  font-weight: 900;

  letter-spacing: 0.08em;

  box-shadow: var(--shadow-sm);
}

.top-block-marker span {
  margin-right: 4px;
}


/* =========================================================
   31. RANDOM SWITCH
========================================================= */

.random-card {
  max-width: 820px;

  margin: 0 auto;

  padding: 28px;

  text-align: center;

  border-radius: 26px;

  background:
    linear-gradient(
      145deg,
      #fffdf9,
      #f2e7de
    );

  border: 1px solid var(--border);

  box-shadow: var(--shadow-sm);
}

.pair-result {
  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 16px;

  margin-top: 22px;
}

.pair-result div {
  padding: 22px;

  border-radius: 18px;

  background: #fffaf6;

  border: 1px solid var(--border);

  color: var(--brown-800);

  font-size: 20px;
  font-weight: 900;
}


/* =========================================================
   32. SECRET STEPS
========================================================= */

.secret-steps {
  max-width: 760px;

  margin: 0 auto;

  display: grid;

  gap: 12px;
}

.secret-steps article {
  display: grid;

  grid-template-columns:
    46px 1fr;

  align-items: center;

  gap: 14px;

  padding: 14px 17px;

  border-radius: 18px;

  background: var(--bg-card);

  border: 1px solid var(--border);

  box-shadow: var(--shadow-xs);
}

.secret-steps article > span {
  width: 42px;
  height: 42px;

  display: grid;
  place-items: center;

  border-radius: 13px;

  background: var(--bg-soft);

  color: var(--brown-500);

  font-weight: 900;
}

.secret-steps p {
  color: var(--brown-800);

  line-height: 1.55;
}

.secret-note {
  max-width: 760px;

  margin: 18px auto 0;

  padding: 12px;

  border-radius: 14px;

  background: var(--brown-700);

  color: white;

  text-align: center;

  font-weight: 800;
}


/* =========================================================
   33. UNLOCK
========================================================= */

.unlock-control {
  max-width: 920px;

  margin: 0 auto 20px;

  display: grid;

  grid-template-columns:
    1fr 1fr auto;

  gap: 12px;

  align-items: end;

  padding: 20px;

  border-radius: 22px;

  background: var(--bg-card);

  border: 1px solid var(--border);

  box-shadow: var(--shadow-sm);
}

.unlock-field label {
  display: block;

  margin-bottom: 6px;

  color: var(--text-soft);

  font-size: 10px;
  font-weight: 800;
}

.unlock-field select,
.unlock-field input {
  width: 100%;

  padding: 12px 13px;

  border: 1px solid var(--border);

  border-radius: 13px;

  outline: none;

  background: #fff;

  color: var(--brown-800);
}

.unlock-field select:focus,
.unlock-field input:focus {
  border-color: var(--brown-400);

  box-shadow:
    0 0 0 4px
    rgba(201, 164, 143, 0.14);
}

.code-error {
  min-height: 22px;

  text-align: center;

  color: #a65353;

  font-size: 11px;
  font-weight: 700;
}


/* =========================================================
   34. CASE GRID
========================================================= */

.case-grid {
  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 18px;
}

.case-slot {
  min-height: 300px;

  position: relative;
  overflow: hidden;

  border-radius: 24px;

  background:
    linear-gradient(
      145deg,
      #fffdf9,
      #f5ebe3
    );

  border:
    1px dashed
    var(--brown-300);

  box-shadow: var(--shadow-sm);
}

.case-locked {
  min-height: 300px;

  display: flex;

  flex-direction: column;

  align-items: center;
  justify-content: center;

  gap: 7px;
}

.case-lock {
  font-size: 30px;
}

.case-locked strong {
  color: var(--brown-800);
}

.case-locked small {
  color: var(--text-soft);
}

.case-content {
  display: none;

  padding: 18px;
}

.case-slot.unlocked {
  border-style: solid;
}

.case-slot.unlocked .case-locked {
  display: none;
}

.case-slot.unlocked .case-content {
  display: block;

  animation:
    pageEnter
    0.3s ease;
}

.case-content img {
  width: 100%;

  aspect-ratio:
    16 / 9;

  object-fit: cover;

  border-radius: 16px;

  margin-bottom: 14px;
}

.case-code {
  display: inline-block;

  margin-bottom: 8px;

  padding: 6px 9px;

  border-radius: 999px;

  background: var(--bg-soft);

  color: var(--brown-500);

  font-size: 9px;
  font-weight: 900;
}

.case-content h4 {
  margin-bottom: 7px;

  color: var(--brown-800);

  font-size: 18px;
}

.case-content p {
  color: var(--text-soft);

  line-height: 1.6;

  font-size: 12.5px;
}


/* =========================================================
   35. DISCUSSION
========================================================= */

.discussion-reminder {
  max-width: 900px;

  margin: 22px auto 0;

  padding: 18px 22px;

  border-radius: 18px;

  background: var(--bg-soft);

  color: var(--brown-800);
}

.discussion-reminder strong {
  display: block;

  margin-bottom: 8px;
}

.discussion-reminder ol {
  padding-left: 20px;
}

.discussion-reminder li {
  margin: 4px 0;

  line-height: 1.55;
}


/* =========================================================
   36. PRESENTATION
========================================================= */

.presentation-page,
.conclusion-page {
  text-align: center;
}

.presentation-groups {
  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  gap: 14px;

  margin: 28px 0;
}

.presentation-groups span {
  padding: 22px 10px;

  border-radius: 20px;

  background: var(--bg-card);

  border: 1px solid var(--border);

  box-shadow: var(--shadow-sm);

  color: var(--brown-800);

  font-weight: 900;
}

.share-note {
  color: var(--text-soft);

  font-size: 12px;
  font-weight: 700;
}

.share-note span {
  padding: 0 7px;
}


/* =========================================================
   37. QUICK CHECK
========================================================= */

.quiz-card {
  max-width: 900px;

  margin: 0 auto;

  padding: 26px;

  border-radius: 24px;

  background:
    linear-gradient(
      145deg,
      #fffdf9,
      #f5ebe3
    );

  border: 1px solid var(--border);

  box-shadow: var(--shadow-sm);
}

.quiz-question {
  margin: 18px 0;

  color: var(--brown-800);

  font-size: 20px;
  font-weight: 700;

  line-height: 1.55;
}

.quiz-options {
  display: grid;

  gap: 10px;
}

.quiz-option {
  width: 100%;

  padding: 13px 15px;

  border: 1px solid var(--border);

  border-radius: 14px;

  background: white;

  color: var(--brown-800);

  text-align: left;

  font-weight: 600;

  transition: 0.18s ease;
}

.quiz-option:hover {
  background: var(--bg-soft);

  transform: translateY(-1px);
}

.quiz-feedback {
  min-height: 44px;

  display: flex;

  align-items: center;

  margin-top: 10px;

  color: var(--brown-500);

  font-size: 22px;
  font-weight: 900;
}


/* =========================================================
   38. CONCLUSION
========================================================= */

.student-conclusion {
  max-width: 780px;

  margin: 20px auto;

  padding: 18px;

  display: flex;

  align-items: center;
  justify-content: center;

  gap: 12px;

  border-radius: 18px;

  background: var(--bg-soft);
}

.student-conclusion > span {
  font-size: 25px;
}

.teacher-conclusion {
  max-width: 850px;

  margin: 0 auto;

  padding: 24px;

  border-radius: 24px;

  background:
    linear-gradient(
      145deg,
      #fffdf9,
      #eee0d4
    );

  border: 1px solid var(--border);

  box-shadow: var(--shadow-sm);
}

.teacher-conclusion small {
  color: var(--brown-500);

  font-size: 9px;
  font-weight: 900;

  letter-spacing: 0.13em;
}

.teacher-conclusion p {
  margin: 10px 0;

  color: var(--text-soft);

  line-height: 1.7;
}

.teacher-conclusion strong {
  color: var(--brown-800);
}


/* =========================================================
   39. CLOSING
========================================================= */

.closing-card {
  min-height:
    calc(100vh - 150px);

  display: flex;

  flex-direction: column;

  align-items: center;
  justify-content: center;

  padding: 42px;

  text-align: center;

  border-radius: 34px;

  background:
    linear-gradient(
      145deg,
      #e7d7ca,
      #fffdf9
    );

  box-shadow: var(--shadow-md);
}

.closing-card h1 {
  margin: 8px 0 22px;

  color: var(--brown-800);

  font-size:
    clamp(
      52px,
      7vw,
      88px
    );

  line-height: 0.98;
}

.closing-quote {
  padding: 18px 24px;

  border-radius: 18px;

  background:
    rgba(255, 255, 255, 0.68);

  color: var(--brown-700);

  line-height: 1.7;

  font-weight: 700;
}

.closing-card > p {
  margin: 20px 0;

  color: var(--brown-500);

  font-style: italic;
}


/* =========================================================
   40. MODAL
========================================================= */

.block-modal,
.document-modal {
  position: fixed;

  inset: 0;

  z-index: 3000;

  display: none;

  align-items: center;
  justify-content: center;

  padding: 22px;

  background:
    rgba(48, 38, 33, 0.5);

  backdrop-filter:
    blur(5px);
}

.block-modal.show,
.document-modal.show {
  display: flex;
}

.block-modal-panel,
.document-modal-panel {
  position: relative;

  width:
    min(720px, 94vw);

  max-height: 92vh;

  overflow-y: auto;

  padding: 28px;

  border-radius: 28px;

  background: var(--bg-card);

  box-shadow: var(--shadow-lg);

  animation:
    modalPop
    0.25s ease;
}

@keyframes modalPop {

  from {
    opacity: 0;

    transform:
      translateY(14px)
      scale(0.97);
  }

  to {
    opacity: 1;

    transform:
      translateY(0)
      scale(1);
  }

}

.modal-close {
  width: 40px;
  height: 40px;

  display: grid;

  place-items: center;

  border: none;

  border-radius: 50%;

  background: var(--bg-soft);

  color: var(--brown-700);

  font-size: 23px;
}

.block-modal-panel > .modal-close {
  position: absolute;

  top: 16px;
  right: 16px;
}

.block-modal-panel h2 {
  margin-bottom: 10px;

  padding-right: 50px;

  color: var(--brown-800);
}

.block-modal-meaning {
  color: var(--text-soft);

  line-height: 1.7;
}

.block-detail-grid {
  display: grid;

  gap: 12px;

  margin-top: 18px;
}

.block-detail-grid > div {
  padding: 14px 16px;

  border-radius: 15px;

  background: var(--bg-main);
}

.block-detail-grid small {
  color: var(--brown-500);

  font-size: 9px;
  font-weight: 900;

  letter-spacing: 0.12em;
}

.block-detail-grid p {
  margin-top: 5px;

  color: var(--text-soft);

  line-height: 1.6;
}


/* =========================================================
   41. DOCUMENT MODAL
========================================================= */

.document-modal-panel {
  width:
    min(900px, 96vw);
}

.document-modal-top {
  display: flex;

  align-items: flex-start;
  justify-content: space-between;

  gap: 16px;

  margin-bottom: 16px;
}

.document-modal-top span {
  color: var(--brown-500);

  font-size: 9px;
  font-weight: 900;

  letter-spacing: 0.13em;
}

.document-modal-top h2 {
  margin-top: 3px;

  color: var(--brown-800);
}

.document-viewer {
  padding: 12px;

  border-radius: 18px;

  background: var(--bg-main);
}

.document-viewer img {
  width: 100%;

  max-height: 75vh;

  object-fit: contain;

  margin: 0 auto;

  border-radius: 10px;
}


/* =========================================================
   42. RESPONSIVE
========================================================= */

@media (max-width: 1050px) {

  .hero-layout {
    grid-template-columns:
      1fr;
  }

  .hero-visual {
    min-height: 330px;
  }

  .goal-grid,
  .apersepsi-grid,
  .style-grid,
  .block-grid {
    grid-template-columns:
      1fr 1fr;
  }

  .learning-flow {
    flex-wrap: wrap;
  }

  .flow-step {
    min-width: 220px;
  }

  .flow-line {
    display: none;
  }

  .agreement-grid,
  .benefit-grid {
    grid-template-columns:
      1fr 1fr;
  }

  .movement-grid {
    grid-template-columns:
      1fr 1fr;
  }

  .silent-layout {
    grid-template-columns:
      1fr;
  }

  .unlock-control {
    grid-template-columns:
      1fr 1fr;
  }

  .unlock-control > button {
    grid-column:
      span 2;
  }

}


@media (max-width: 720px) {

  .sidebar-toggle {
    top: 14px;
    left: 14px;
  }

  .sidebar {
    width:
      min(88vw, 310px);
  }

  .page {
    width: 92%;

    padding:
      78px 0 40px;
  }

  .section-card,
  .hero-card,
  .transition-card,
  .closing-card {
    padding: 22px;

    border-radius: 24px;
  }

  .hero-text h1 {
    font-size: 42px;
  }

  .hero-visual {
    min-height: 260px;
  }

  .goal-grid,
  .apersepsi-grid,
  .agreement-grid,
  .benefit-grid,
  .style-grid,
  .block-grid,
  .reflection-grid,
  .hand-code-grid,
  .case-grid,
  .pair-result {
    grid-template-columns:
      1fr;
  }

  .movement-grid {
    grid-template-columns:
      1fr 1fr;
  }

  .presentation-groups {
    grid-template-columns:
      1fr 1fr;
  }

  .unlock-control {
    grid-template-columns:
      1fr;
  }

  .unlock-control > button {
    grid-column:
      auto;
  }

  .page-navigation {
    flex-direction:
      column-reverse;

    align-items:
      stretch;
  }

  .page-navigation button {
    width: 100%;
  }

  .chat-stage {
    padding: 22px;
  }

  .chat-bubble {
    font-size: 28px;
  }

  .mystery-scene {
    height: 410px;
  }

  .box-body-image {
    width: 255px;
    bottom: 38px;
  }

  .box-lid-image {
    width: 265px;
    bottom: 177px;
  }

  .box-inside {
    bottom: 172px;
    width: 200px;
    height: 54px;
  }

  .flying-block {
    width: 65px;
    bottom: 168px;
  }

  .document-tool {
    padding: 14px;
  }

}


@media (max-width: 480px) {

  .movement-grid,
  .presentation-groups {
    grid-template-columns:
      1fr;
  }

  .hero-tagline {
    font-size: 17px;
  }

  .page-title {
    font-size: 32px;
  }

  .big-time-number {
    font-size: 100px;
  }

  .chat-controls {
    flex-wrap: wrap;
  }

  .chat-controls button {
    flex:
      1 1 42%;
  }

  .mystery-scene {
    height: 360px;
  }

  .box-body-image {
    width: 220px;
    bottom: 30px;
  }

  .box-lid-image {
    width: 230px;
    bottom: 150px;
  }

  .box-inside {
    bottom: 145px;
    width: 172px;
    height: 48px;
  }

  .flying-block {
    width: 56px;
    bottom: 145px;
  }

  .document-tool-text strong {
    font-size: 15px;
  }

}
