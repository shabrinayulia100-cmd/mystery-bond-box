  color: var(--brown-700);

  background: #fffaf6;

  border: 1px solid var(--border);

  box-shadow: var(--shadow-xs);
}

.btn-secondary:hover {
  transform: translateY(-2px);

  background: var(--bg-soft);
}

.btn-large {
  padding: 16px 28px;
  font-size: 15px;
}

button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
  transform: none !important;
}


/* =========================================================
   11. PAGE NAVIGATION
========================================================= */

.page-navigation {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 14px;

  margin-top: 34px;
}


/* =========================================================
   12. HERO
========================================================= */

.hero-card {
  position: relative;
  overflow: hidden;

  padding: 46px;

  min-height:
    calc(100vh - 140px);

  display: grid;
  align-items: center;

  border-radius: 36px;

  background:
    linear-gradient(
      135deg,
      rgba(255, 253, 249, 0.94),
      rgba(239, 226, 214, 0.86)
    );

  box-shadow: var(--shadow-md);

  border:
    1px solid
    rgba(255, 255, 255, 0.85);
}

.hero-layout {
  display: grid;

  grid-template-columns:
    1.05fr 0.95fr;

  gap: 36px;

  align-items: center;
}

.hero-badge {
  display: inline-block;

  margin-bottom: 14px;

  padding: 8px 13px;

  border-radius: 999px;

  background: var(--bg-soft);

  color: var(--brown-600);

  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.13em;
}

.hero-text h1 {
  margin-bottom: 18px;

  font-size:
    clamp(
      48px,
      6vw,
      76px
    );

  line-height: 1.01;
  letter-spacing: -0.04em;

  color: var(--brown-800);
}

.hero-description {
  max-width: 610px;

  color: var(--text-soft);

  font-size: 16px;
  line-height: 1.75;
}

.hero-tagline {
  display: inline-block;

  margin: 22px 0 10px;

  padding: 12px 18px;

  border-left:
    5px solid
    var(--brown-500);

  border-radius: 12px;

  background:
    rgba(255, 255, 255, 0.72);

  color: var(--brown-700);

  font-size: 20px;
  font-weight: 700;

  box-shadow: var(--shadow-xs);
}

.hero-tagline strong {
  color: var(--brown-500);
}

.hero-meta {
  margin-bottom: 24px;

  color: var(--text-soft);

  font-size: 13px;
}

.hero-meta span {
  padding: 0 6px;
}

.hero-visual {
  position: relative;

  min-height: 430px;

  display: grid;
  place-items: center;
}

.hero-visual img {
  position: relative;
  z-index: 3;

  width:
    min(520px, 100%);

  object-fit: contain;

  filter:
    drop-shadow(
      0 24px 26px
      rgba(90, 64, 51, 0.16)
    );
}

.hero-blob {
  position: absolute;
  border-radius: 50%;
}

.hero-blob-one {
  width: 280px;
  height: 280px;

  right: 10%;
  top: 10%;

  background:
    rgba(201, 164, 143, 0.25);
}

.hero-blob-two {
  width: 180px;
  height: 180px;

  left: 5%;
  bottom: 7%;

  background:
    rgba(223, 198, 182, 0.3);
}


/* =========================================================
   13. GOAL GRID
========================================================= */

.goal-grid {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 20px;
}

.goal-card {
  position: relative;

  padding: 26px;

  border-radius: 24px;

  background:
    linear-gradient(
      145deg,
      #fffdf9,
      #f8efe7
    );

  border: 1px solid var(--border);

  box-shadow: var(--shadow-sm);

  transition: 0.2s ease;
}

.goal-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow-md);
}

.goal-number {
  position: absolute;

  top: 16px;
  right: 18px;

  color: var(--brown-300);

  font-size: 13px;
  font-weight: 900;
}

.goal-icon {
  width: 52px;
  height: 52px;

  display: grid;
  place-items: center;

  margin-bottom: 16px;

  border-radius: 16px;

  background: var(--bg-soft);

  font-size: 23px;
}

.goal-card h3 {
  margin-bottom: 8px;

  color: var(--brown-800);
}

.goal-card p {
  color: var(--text-soft);

  line-height: 1.7;

  font-size: 14px;
}


/* =========================================================
   14. FLOW
========================================================= */

.learning-flow {
  display: flex;

  align-items: center;
  justify-content: center;

  gap: 13px;

  margin: 42px auto 0;
}

.flow-step {
  flex: 1;

  min-height: 145px;

  display: flex;

  flex-direction: column;

  justify-content: center;

  padding: 22px;

  border-radius: 22px;

  background: var(--bg-card);

  border: 1px solid var(--border);

  box-shadow: var(--shadow-xs);
}

.flow-step span {
  color: var(--brown-400);

  font-size: 11px;
  font-weight: 900;
}

.flow-step strong {
  margin: 6px 0 4px;

  color: var(--brown-800);

  font-size: 19px;
}

.flow-step small {
  color: var(--text-soft);
}

.flow-step-featured {
  background:
    linear-gradient(
      145deg,
      #ead9cc,
      #fffdf9
    );
}

.flow-line {
  color: var(--brown-400);
  font-size: 24px;
}


/* =========================================================
   15. TIME
========================================================= */

.time-page {
  text-align: center;
}

.big-time {
  margin: 24px auto;

  display: flex;

  flex-direction: column;

  align-items: center;
}

.big-time-number {
  font-family:
    "Nunito",
    sans-serif;

  font-size:
    clamp(
      110px,
      15vw,
      180px
    );

  line-height: 0.88;

  font-weight: 900;

  color: var(--brown-800);
}

.big-time-label {
  margin-top: 16px;

  color: var(--brown-500);

  font-size: 15px;
  letter-spacing: 0.22em;

  font-weight: 900;
}

.time-description {
  max-width: 720px;

  margin: 0 auto;

  color: var(--text-soft);

  line-height: 1.8;
}


/* =========================================================
   16. APERSEPSI
========================================================= */

.apersepsi-grid {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 20px;
}

.apersepsi-card {
  overflow: hidden;

  position: relative;

  border-radius: 24px;

  background: var(--bg-card);

  border: 1px solid var(--border);

  box-shadow: var(--shadow-sm);

  transition: 0.2s ease;
}

.apersepsi-card:hover {
  transform: translateY(-4px);
}

.apersepsi-card img {
  width: 100%;

  aspect-ratio:
    16 / 10;

  object-fit: cover;
}

.card-number {
  display: inline-grid;

  place-items: center;

  width: 38px;
  height: 38px;

  margin: 16px 16px 8px;

  border-radius: 12px;

  background: var(--bg-soft);

  color: var(--brown-500);

  font-size: 12px;
  font-weight: 900;
}

.apersepsi-card p {
  padding: 0 17px 22px;

  color: var(--brown-800);

  line-height: 1.65;

  font-weight: 700;

  font-size: 14px;
}

.statement-card {
  display: flex;

  align-items: flex-start;

  gap: 16px;

  margin-top: 26px;

  padding: 20px 22px;

  border-radius: 20px;

  background: #f2e6dc;

  border: 1px solid var(--border);
}

.statement-icon {
  width: 44px;
  height: 44px;

  flex-shrink: 0;

  display: grid;
  place-items: center;

  border-radius: 14px;

  background: var(--brown-700);

  color: white;
}

.statement-card h3 {
  margin-bottom: 5px;
  color: var(--brown-800);
}

.statement-card p {
  color: var(--text-soft);
  line-height: 1.7;
}


/* =========================================================
   17. ICE BREAKING
========================================================= */

.movement-grid {
  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  gap: 16px;
}

.movement-card {
  padding: 26px 16px;

  text-align: center;

  border-radius: 22px;

  background: var(--bg-card);

  border: 1px solid var(--border);

  box-shadow: var(--shadow-sm);
}

.movement-arrow {
  display: block;

  margin-bottom: 9px;

  color: var(--brown-500);

  font-size: 48px;
}

.movement-card strong {
  display: block;

  margin-bottom: 4px;

  color: var(--brown-800);
}

.movement-card small {
  color: var(--text-soft);
}

.quote-card {
  max-width: 900px;

  margin: 24px auto 0;

  padding: 18px 22px;

  border-radius: 18px;

  background:
    linear-gradient(
      145deg,
      #eadfd5,
      #fffdf9
    );

  border: 1px solid var(--border);

  color: var(--brown-700);

  text-align: center;

  line-height: 1.7;

  font-weight: 700;
}


/* =========================================================
   18. TRANSITION
========================================================= */

.transition-card {
  min-height:
    calc(100vh - 150px);

  display: flex;

  flex-direction: column;

  align-items: center;
  justify-content: center;

  padding: 40px;

  text-align: center;

  border-radius: 34px;

  background:
    linear-gradient(
      145deg,
      #f1e4d8,
      #fffdf9
    );

  box-shadow: var(--shadow-md);

  border:
    1px solid
    rgba(255, 255, 255, 0.8);
}

.transition-symbol {
  width: 82px;
  height: 82px;

  display: grid;
  place-items: center;

  margin: 8px 0 18px;

  border-radius: 26px;

  background: var(--brown-700);

  color: white;

  font-size: 34px;

  box-shadow: var(--shadow-sm);
}

.transition-card h1 {
  margin-bottom: 10px;

  color: var(--brown-800);

  font-size:
    clamp(
      42px,
      5vw,
      68px
    );
}

.transition-card p {
  margin-bottom: 26px;
  color: var(--text-soft);
}


/* =========================================================
   19. AGREEMENT + BENEFIT
========================================================= */

.agreement-grid,
.benefit-grid {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 18px;
}

.agreement-grid article,
.benefit-grid article {
  padding: 24px;

  border-radius: 22px;

  background: var(--bg-card);

  border: 1px solid var(--border);

  box-shadow: var(--shadow-sm);
}

.agreement-grid article > span,
.benefit-grid article > span {
  display: block;

  margin-bottom: 12px;

  font-size: 30px;
}

.agreement-grid h3,
.benefit-grid h3 {
  margin-bottom: 7px;

  color: var(--brown-800);
}

.agreement-grid p,
.benefit-grid p {
  color: var(--text-soft);

  line-height: 1.65;

  font-size: 14px;
}

.group-notice {
  display: flex;

  align-items: center;

  gap: 16px;

  margin-top: 24px;

  padding: 18px 22px;

  border-radius: 20px;

  background: var(--bg-soft);
}

.group-notice > span {
  font-size: 30px;
}

.group-notice strong {
  color: var(--brown-800);
}

.group-notice p {
  margin-top: 3px;
  color: var(--text-soft);
}


/* =========================================================
   20. CHAT
========================================================= */

.chat-stage {
  max-width: 850px;

  margin: 0 auto;

  padding: 34px;

  border-radius: 28px;

  background:
    linear-gradient(
      145deg,
      #f0e4da,
      #fffdf9
    );

  box-shadow: var(--shadow-sm);

  border: 1px solid var(--border);
}

.chat-message {
  display: none;

  min-height: 210px;

  place-items: center;
}

.chat-message.active-chat {
  display: grid;

  animation:
    chatPop
    0.28s ease;
}

@keyframes chatPop {

  from {
    opacity: 0;

    transform:
      scale(0.94)
      translateY(7px);
  }

  to {
    opacity: 1;

    transform:
      scale(1)
      translateY(0);
  }

}

.chat-bubble {
  position: relative;

  display: inline-flex;

  align-items: center;

  gap: 14px;

  max-width: 610px;

  padding: 22px 28px;

  border-radius:
    28px 28px 28px 8px;

  background:
    linear-gradient(
      135deg,
      #6c4939,
      #51362b
    );

  color: white;

  box-shadow:
    0 18px 34px
    rgba(69, 47, 37, 0.26);

  font-size:
    clamp(
      28px,
      4vw,
      44px
    );

  font-weight: 800;
}

.chat-bubble::after {
  content: "";

  position: absolute;

  left: 10px;
  bottom: -12px;

  width: 24px;
  height: 24px;

  background: #51362b;

  clip-path:
    polygon(
      0 0,
      100% 0,
      0 100%
    );
}

.bubble-icon {
  font-size: 26px;

  filter:
    grayscale(1)
    brightness(6);
}

.chat-controls {
  display: flex;

  align-items: center;

  justify-content: center;

  gap: 16px;

  margin-top: 24px;
}

.counter-pill {
  min-width: 78px;

  padding: 9px 14px;

  border-radius: 999px;

  background: var(--bg-soft);

  color: var(--brown-600);

  text-align: center;

  font-size: 12px;
  font-weight: 900;
}


/* =========================================================
   21. REFLECTIVE
========================================================= */

.mini-chat-list {
  display: flex;

  flex-wrap: wrap;

  justify-content: center;

  gap: 9px;

  margin-bottom: 22px;
}

.mini-chat-list span {
  padding: 8px 13px;

  border-radius: 999px;

  background: var(--bg-soft);

  color: var(--brown-600);

  font-size: 12px;
  font-weight: 700;
}

.reflection-grid {
  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 18px;
}

.reflection-card {
  padding: 24px;

  border-radius: 22px;

  background:
    linear-gradient(
      145deg,
      #fffdf9,
      #f7eee7
    );

  border: 1px solid var(--border);

  box-shadow: var(--shadow-sm);
}

.reflection-number {
  display: grid;

  place-items: center;

  width: 42px;
  height: 42px;

  margin-bottom: 14px;

  border-radius: 13px;

  background: var(--bg-soft);

  color: var(--brown-500);

  font-size: 12px;
  font-weight: 900;
}

.reflection-card p {
  color: var(--brown-800);

  font-size: 17px;
  font-weight: 700;

  line-height: 1.65;
}


/* =========================================================
   22. DOCUMENT TOOL
========================================================= */

.document-tool {
  width: 100%;

  max-width: 780px;

  margin: 24px auto 0;

  padding: 16px 20px;

  display: flex;

  align-items: center;

  gap: 16px;

  border: 1px solid var(--border);

  border-radius: 20px;

  background:
    linear-gradient(
      135deg,
      #fffdf9,
      #efe2d7
    );

  color: var(--brown-800);

  box-shadow: var(--shadow-sm);

  text-align: left;

  transition: 0.22s ease;
}

.document-tool:hover {
  transform: translateY(-3px);

  box-shadow: var(--shadow-md);
}

.document-tool-featured {
  background:
    linear-gradient(
      135deg,
      #eee0d4,
      #fffdf9
    );
}

.document-tool-icon {
  width: 52px;
  height: 52px;

  flex-shrink: 0;

  display: grid;

  place-items: center;

  border-radius: 16px;

  background: var(--brown-700);

  color: white;

  font-size: 24px;
}

.document-tool-text {
  flex: 1;

  display: flex;

  flex-direction: column;
}

.document-tool-text small {
  color: var(--brown-500);

  font-size: 9px;
  font-weight: 900;

  letter-spacing: 0.12em;
}

.document-tool-text strong {
  margin: 2px 0;

  color: var(--brown-800);

  font-size: 17px;
}

.document-tool-text em {
  color: var(--text-soft);

  font-size: 11px;

  font-style: normal;
}

.document-tool-arrow {
  color: var(--brown-600);

  font-size: 25px;
}


/* =========================================================
   23. DEFINITION
========================================================= */

.definition-card {
  position: relative;

  max-width: 900px;

  margin: 0 auto 26px;

  padding: 28px;

  border-radius: 24px;

  background: var(--bg-card);

  border: 1px solid var(--border);

  box-shadow: var(--shadow-sm);
}

.definition-mark {
  position: absolute;

  top: 8px;
  left: 18px;

  color: var(--brown-300);

  font-size: 70px;

  line-height: 1;
}

.definition-card > p {
  position: relative;
  z-index: 2;

  color: var(--text-soft);

  line-height: 1.8;
}

.definition-highlight {
  margin: 20px 0;

  padding: 15px 18px;

  border-radius: 15px;

  background: var(--bg-soft);

  color: var(--brown-700);

  font-weight: 700;
}

.definition-card small {
  color: var(--text-soft);

  font-size: 11px;
}


/* =========================================================
   24. STYLE CARDS
========================================================= */

.style-grid {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 18px;
}

.style-card {
  padding: 23px;

  border-radius: 22px;

  background: var(--bg-card);

  border: 1px solid var(--border);

  box-shadow: var(--shadow-sm);
}

.style-label {
  display: inline-block;

  margin-bottom: 10px;

  font-size: 9px;
  font-weight: 900;

  letter-spacing: 0.13em;
}

.style-card h3 {
  margin-bottom: 9px;

  color: var(--brown-800);

  font-size: 18px;
}

.style-card p {
  color: var(--text-soft);

  line-height: 1.65;

  font-size: 13px;
}

.passive-card {
  border-top:
    6px solid
    var(--passive);
}

.aggressive-card {
  border-top:
    6px solid
    var(--aggressive);
}

.assertive-card {
  border-top:
    6px solid
    var(--assertive);
}


/* =========================================================
   25. MINI GAME
========================================================= */

.hand-code-grid {
  max-width: 760px;

  margin: 0 auto 22px;

  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 15px;
}

.hand-code {
  padding: 18px;

  text-align: center;

  border-radius: 20px;

  background: var(--bg-card);

  border: 1px solid var(--border);

  box-shadow: var(--shadow-sm);
}

.hand-code span {
  display: block;

  margin-bottom: 6px;

  font-size: 30px;
}

.hand-code strong {
  display: block;

  color: var(--brown-800);

  font-size: 20px;
}

.hand-code small {
  color: var(--text-soft);
}

.mini-game-card {
  max-width: 900px;

  margin: 0 auto;

  padding: 28px;

  text-align: center;

  border-radius: 26px;

  background:
    linear-gradient(
      145deg,
      #fffdf9,
      #f5ebe3
    );

  border: 1px solid var(--border);

  box-shadow: var(--shadow-md);
}

#miniQuestion {
  margin: 18px 0;

  color: var(--brown-800);

  font-size:
    clamp(
      20px,
      2.3vw,
      28px
    );

  font-weight: 700;

  line-height: 1.55;
}

#miniAnswer {
  min-height: 38px;

  margin-top: 14px;

  color: var(--brown-500);

  font-size: 20px;
  font-weight: 900;
}

.mini-controls {
  display: flex;

  justify-content: center;

  gap: 12px;

  margin-top: 16px;
}


/* =========================================================
   26. SITUATION TAGS
========================================================= */

.situation-tags {
  display: flex;

  flex-wrap: wrap;

  justify-content: center;

  gap: 12px;

  margin: 34px auto;
}

.situation-tags span {
  padding: 12px 17px;

  border-radius: 999px;

  background: var(--bg-card);

  border: 1px solid var(--border);

  box-shadow: var(--shadow-xs);

  color: var(--brown-700);

  font-weight: 700;
}

.ready-card {
  max-width: 760px;

  margin: 32px auto 0;

  padding: 28px;

  text-align: center;

  border-radius: 26px;

  background:
    linear-gradient(
      145deg,
      #e7d7ca,
      #fffdf9
    );

  box-shadow: var(--shadow-md);
}

.ready-card small {
  color: var(--brown-500);

  font-size: 9px;

  letter-spacing: 0.13em;

  font-weight: 900;
}

.ready-card h2 {
  margin: 6px 0 18px;

  color: var(--brown-800);

  font-size: 30px;
}


/* =========================================================
   27. MYSTERY BOX
========================================================= */

.mystery-section {
  text-align: center;
}


/* AREA UTAMA BOX */

.mystery-scene {
  position: relative;

  width: min(620px, 90vw);
  height: 470px;

  margin: 6px auto 0;

  perspective: 1300px;

  display: flex;
  align-items: center;
  justify-content: center;
}


/* SATU KESATUAN BOX */

.box-object {
  position: relative;

  width: 430px;
  height: 410px;

  transform-style: preserve-3d;

  transition:
    transform 0.18s ease-out;
}


/* =========================================================
   SHADOW
========================================================= */

.box-shadow-image {
  position: absolute;

  z-index: 1;

  left: 50%;
  bottom: 18px;

  width: 330px;

  transform:
    translateX(-50%)
    scaleX(1.08);

  opacity: 0.42;

  pointer-events: none;

  filter: blur(1px);
}


/* =========================================================
   BODY BOX
========================================================= */

.box-body-image {
  position: absolute;

  z-index: 8;

  left: 50%;
  bottom: 8px;

  width: 365px;

  transform:
    translateX(-50%);

  cursor: pointer;

  filter:
    drop-shadow(
      0 22px 24px
      rgba(48, 38, 33, 0.22)
    );

  transition:
    transform 0.3s ease;
}


/* =========================================================
   BAGIAN DALAM BOX
========================================================= */

.box-inside {
  position: absolute;

  z-index: 6;

  left: 50%;
  bottom: 235px;

  width: 270px;
  height: 64px;

  transform:
    translateX(-50%)
    scaleY(0.55);

  border-radius: 50%;

  background:
    radial-gradient(
      ellipse,
      #050505 0%,
      #111111 55%,
      #29231f 100%
    );

  opacity: 0;

  transition:
    opacity 0.3s ease;
}


/* =========================================================
   LID
   KONDISI AWAL = MENUTUP BOX
========================================================= */

.box-lid-image {
  position: absolute;
  z-index: 12;
  left: 50%;
  bottom: 125px;
  width: 378px;
  transform: translateX(-50%) translateY(0) rotateX(0deg) rotateZ(0deg);
  transform-origin: 50% 86%;
  cursor: pointer;
  filter: drop-shadow(0 7px 9px rgba(20, 15, 12, 0.18));
  transition: 
    transform 0.78s cubic-bezier(0.22, 1, 0.36, 1),
    opacity 0.35s ease,
    visibility 0.35s ease;
}

/* saat dibuka */
.box-object.opened .box-lid-image {
  transform: translateX(-50%) translateY(-145px) rotateX(-58deg) rotateZ(-2deg);
}

/* setelah dibuka, tutup hilang */
.box-object.hide-lid .box-lid-image {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}


/* =========================================================
   GLOW
========================================================= */

.box-glow-image {
  position: absolute;

  z-index: 5;

  left: 50%;
  bottom: 158px;

  width: 380px;

  transform:
    translateX(-50%)
    scale(0.55);

  opacity: 0;

  pointer-events: none;

  transition:
    opacity 0.5s ease,
    transform 0.6s ease;
}


/* =========================================================
   BALOK - KONDISI AWAL
========================================================= */

.flying-block {
  position: absolute;

  z-index: 7;

  left: 50%;
  bottom: 230px;

  width: 72px;

  opacity: 0;

  pointer-events: none;

  transform:
    translateX(-50%)
    translateY(45px)
    scale(0.45);

  filter:
    drop-shadow(
      0 9px 10px
      rgba(48, 38, 33, 0.15)
    );

  transition:
    transform 0.75s
    cubic-bezier(
      0.22,
      1,
      0.36,
      1
    ),
    opacity 0.35s ease;
}


/* =========================================================
   SAAT HOVER SEBELUM DIBUKA
========================================================= */

.box-object:not(.opened):hover .box-body-image {
  transform:
    translateX(-50%)
    translateY(-3px);
}

.box-object:not(.opened):hover .box-lid-image {
  transform:
    translateX(-50%)
    translateY(-4px);
}


/* =========================================================
   OPEN STATE
========================================================= */

/*
   Tutup tidak langsung terbang jauh.
   Dia naik sedikit lalu miring ke belakang.
*/

.box-object.opened .box-lid-image {
  transform:
    translateX(-50%)
    translateY(-112px)
    rotateX(-58deg)
    rotateZ(-2deg);
}


/* Body turun sedikit supaya gerakan terasa alami */

.box-object.opened .box-body-image {
  transform:
    translateX(-50%)
    translateY(4px);
}


/* Bagian dalam baru terlihat */

.box-object.opened .box-inside {
  opacity: 1;
}


/* Glow muncul dari dalam */

.box-object.opened .box-glow-image {
  opacity: 0.72;

  transform:
    translateX(-50%)
    scale(1);
}


/* =========================================================
   BALOK KELUAR
========================================================= */

.box-object.opened .block-fly-1 {
  opacity: 1;

  transform:
    translateX(-50%)
    translate(-128px, -105px)
    rotate(-9deg)
    scale(0.95);

  transition-delay: 0.20s;
}


.box-object.opened .block-fly-2 {
  opacity: 1;

  transform:
    translateX(-50%)
    translate(-64px, -155px)
    rotate(6deg)
    scale(0.95);

  transition-delay: 0.28s;
}


.box-object.opened .block-fly-3 {
  opacity: 1;

  transform:
    translateX(-50%)
    translate(0, -178px)
    rotate(-3deg)
    scale(1);

  transition-delay: 0.36s;
}


.box-object.opened .block-fly-4 {
  opacity: 1;

  transform:
    translateX(-50%)
    translate(64px, -155px)
    rotate(7deg)
    scale(0.95);

  transition-delay: 0.44s;
}


.box-object.opened .block-fly-5 {
  opacity: 1;

  transform:
    translateX(-50%)
    translate(128px, -105px)
    rotate(-6deg)
    scale(0.95);

  transition-delay: 0.52s;
}


.box-object.opened .block-fly-6 {
  opacity: 1;

  transform:
    translateX(-50%)
    translate(0, -95px)
    rotate(3deg)
    scale(0.92);

  transition-delay: 0.60s;
}


/* =========================================================
   CLICK HINT
========================================================= */

.mystery-click-hint {
  position: relative;

  z-index: 20;

  margin-top: -18px;

  color: var(--brown-500);

  font-size: 12px;

  font-weight: 800;

  letter-spacing: 0.02em;

  transition:
    opacity 0.3s ease;
}


/* =========================================================
   AFTER OPEN
========================================================= */

.mystery-after-open {
  display: none;

  max-width: 720px;

  margin: 10px auto 0;

  padding: 18px 22px;

  border-radius: 20px;

  background:
    rgba(255, 253, 249, 0.82);

  border:
    1px solid
    rgba(90, 64, 51, 0.08);

  box-shadow:
    0 10px 25px
    rgba(69, 47, 37, 0.08);
}


.mystery-after-open.show {
  display: block;

  animation:
    mysteryTextUp
    0.45s ease;
}


@keyframes mysteryTextUp {

  from {
    opacity: 0;

    transform:
      translateY(12px);
  }

  to {
    opacity: 1;

    transform:
      translateY(0);
  }

}


.mystery-after-open h3 {
  margin-bottom: 6px;

  color: var(--brown-800);

  font-size: 25px;
}


.mystery-after-open p {
  margin-bottom: 16px;

  color: var(--text-soft);

  line-height: 1.7;
}


/* =========================================================
   RESPONSIVE MYSTERY BOX
========================================================= */

@media (max-width: 720px) {

  .mystery-scene {
    width: 100%;
    height: 410px;
  }

  .box-object {
    width: 360px;
    height: 360px;
  }

  .box-body-image {
    width: 300px;
    bottom: 10px;
  }

  .box-lid-image {
    width: 310px;
    bottom: 151px;
  }

  .box-inside {
