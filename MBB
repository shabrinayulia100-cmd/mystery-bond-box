      options: [

        "Terserah kalian aja.",

        "Aku punya pendapat berbeda. Boleh aku jelaskan dulu?",

        "Pendapat kalian salah. Pokoknya pakai idenya aku."

      ],

      correct: 1
    }

  ];


  const quizCounter =
    document.getElementById("quizCounter");

  const quizQuestion =
    document.getElementById("quizQuestion");

  const quizOptions =
    document.getElementById("quizOptions");

  const quizFeedback =
    document.getElementById("quizFeedback");

  const nextQuiz =
    document.getElementById("nextQuiz");


  let currentQuiz = 0;
  let quizCorrect = false;


  function renderQuiz() {

    const quiz =
      quizData[currentQuiz];


    quizCorrect = false;


    if (quizCounter) {

      quizCounter.textContent =
        `${currentQuiz + 1} / ${quizData.length}`;

    }


    if (quizQuestion) {
      quizQuestion.textContent = quiz.question;
    }


    if (quizFeedback) {
      quizFeedback.textContent = "";
    }


    if (quizOptions) {

      quizOptions.innerHTML = "";


      quiz.options.forEach(
        function (option, index) {

          const button =
            document.createElement("button");


          button.type = "button";

          button.className = "quiz-option";

          button.textContent = option;


          button.addEventListener(
            "click",
            function () {

              checkQuizAnswer(index);

            }
          );


          quizOptions.appendChild(button);

        }
      );

    }


    if (nextQuiz) {

      nextQuiz.disabled = true;


      nextQuiz.textContent =
        currentQuiz === quizData.length - 1
          ? "Selesai ✓"
          : "Soal Berikutnya →";

    }

  }


  function checkQuizAnswer(selectedIndex) {

    const quiz =
      quizData[currentQuiz];


