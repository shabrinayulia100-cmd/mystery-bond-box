  let silentSeconds = 30;
  let silentInterval = null;


  function renderSilentTimer() {

    if (!silentTimer) return;


    const seconds =
      String(silentSeconds)
        .padStart(2, "0");


    silentTimer.textContent =
      `00:${seconds}`;

  }


  if (startSilentTimer) {

    startSilentTimer.addEventListener(
      "click",
      function () {

        if (silentInterval) return;


        if (silentSeconds <= 0) {

          silentSeconds = 30;

          if (silentMessage) {
            silentMessage.textContent = "";
          }

          renderSilentTimer();

        }


        startSilentTimer.disabled = true;


        silentInterval =
          setInterval(
            function () {

              silentSeconds--;

              renderSilentTimer();


              if (silentSeconds <= 0) {

                clearInterval(silentInterval);

                silentInterval = null;

                startSilentTimer.disabled = false;


                if (silentMessage) {
                  silentMessage.textContent = "TIME'S UP! ✦";
                }

              }

            },
            1000
          );

      }
    );

  }


  if (resetSilentTimer) {

    resetSilentTimer.addEventListener(
      "click",
      function () {

        clearInterval(silentInterval);

        silentInterval = null;

        silentSeconds = 30;


        if (startSilentTimer) {
          startSilentTimer.disabled = false;
        }


        if (silentMessage) {
          silentMessage.textContent = "";
        }


        renderSilentTimer();

      }
    );

