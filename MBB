      transparent 22%
    ),
    radial-gradient(
      circle at 85% 88%,
      rgba(155, 115, 95, 0.12),
      transparent 26%
    ),
    linear-gradient(
      180deg,
      #fbf7f2 0%,
      #f6eee7 100%
    );
