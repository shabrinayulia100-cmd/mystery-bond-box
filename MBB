        quizFeedback.textContent = "TRY AGAIN ↻";
      }

    }

  }


  if (nextQuiz) {

    nextQuiz.addEventListener(
      "click",
      function () {

        if (!quizCorrect) return;


        if (currentQuiz < quizData.length - 1) {

          currentQuiz++;

          renderQuiz();

